# Application/content mode. Production must use verified content.
APP_ENV=development
CONTENT_MODE=verified
AGENT_MODE=mock

# Optional frozen build identifier supplied by the release pipeline.
RC_ID=

# Stage 6B DeepSeek server-only configuration. Never prefix secrets with NEXT_PUBLIC_.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REQUEST_TIMEOUT_MS=20000

# The application live gate remains closed until verified content and live UI
# integration have passed their separate acceptance gates.
STAGE6_LIVE_API_ENABLED=false
STAGE6_PROVIDER_POLICY_ACCEPTED=false

# Stage 7 Agnes image generation. Server-side only; never use NEXT_PUBLIC_*.
# Stage 9/10 release uses the three approved fixed portraits. Keep this false.
AGNES_IMAGE_ENABLED=false
AGNES_API_KEY=
AGNES_API_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_IMAGE_SIZE=2K
AGNES_IMAGE_RATIO=3:4
AGNES_IMAGE_TIMEOUT_MS=120000
